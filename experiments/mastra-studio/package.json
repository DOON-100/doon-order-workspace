    "test:departments": "node --test department-tools.test.mjs ../agent-server/business-api.test.mjs ../agent-server/live-studio.test.mjs ../agent-server/schedule-worker.test.mjs",
    "test:purchases": "node ../agent-server/purchase-change.integration.mjs",
    "test:process-changes": "node ../agent-server/process-change.integration.mjs",
    "test:workflows": "node --test workflow-manager.test.mjs workflow-triggers.test.mjs workflow-tools.test.mjs workflow-schedule.test.mjs",
    "test:manager": "node --test agent-manager.test.mjs prompt-reference.test.mjs",
    "test:editor": "node --test editor.test.mjs",
    "test:autonomy": "node --test autonomy/engine.test.mjs autonomy/http.test.mjs autonomy/chain.test.mjs autonomy/multi-user.test.mjs",
    "start:autonomy": "node autonomy/start.mjs",
    "start:chain": "node autonomy/start-chain.mjs",
    "test:locale": "node --test localization.test.mjs",
    "test:auth": "node --test ../agent-server/session.test.mjs ../agent-server/server.test.mjs ../agent-server/loading.test.mjs auth-status.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "1.0.63",
    "@mastra/core": "1.78.0",
    "@mastra/editor": "0.16.3",
    "@mastra/hono": "1.7.20",
    "@mastra/libsql": "1.26.1",
    "@mastra/memory": "1.21.1",
    "@mastra/observability": "1.20.1",
    "@mastra/pg": "1.31.2",
    "acorn": "8.19.0",
    "hono": "4.13.5",
    "mastra": "1.34.2",
    "zod": "3.25.76"
  }
