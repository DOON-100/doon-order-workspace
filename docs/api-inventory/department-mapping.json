{
  "format": "doon-department-tool-planning-v1",
  "status": "planning-only",
  "description": "接口分组与适配配置，不是可执行工具注册表；分组不授予权限。",
  "modules": {
    "app/api/workspace/[action]/route.ts": ["planning"],
    "lib/operations.ts": ["production", "planning"],
    "lib/collaboration-api.ts": ["service", "planning"],
    "lib/supplier-api.ts": ["purchasing"],
    "lib/loss-api.ts": ["production"],
    "lib/purchase-api.ts": ["purchasing"],
    "lib/pmc-api.ts": ["planning"],
    "lib/finished-supplier-api.ts": ["purchasing"],
    "lib/kingdee-pending-api.ts": ["purchasing"],
    "lib/process-workspace-api.ts": ["sales", "service", "engineering", "planning", "warehouse", "quality", "finance"],
    "lib/process-change-api.ts": ["sales", "service", "engineering", "planning", "warehouse", "quality", "finance"],
    "lib/planning-control-api.ts": ["planning"],
    "lib/engineering-drawing-api.ts": ["engineering"],
    "lib/drawing-correction-api.ts": ["engineering", "planning"],
    "lib/engineering-sop-api.ts": ["engineering"],
    "lib/service-workspace-api.ts": ["service", "warehouse", "finance"],
    "lib/customer-quote-api.ts": ["sales"],
    "lib/customer-quote-policy-api.ts": ["management"],
    "lib/customer-quote-template-api.ts": ["sales"],
    "lib/customer-price-archive-api.ts": ["sales"],
    "lib/customer-workflow-api.ts": ["sales", "service"],
    "lib/customer-workflow-files.ts": ["sales", "service"],
    "lib/customer-workflow-tasks.ts": ["sales", "service"],
    "lib/customer-workflow-transfers.ts": ["sales"],
    "lib/customer-project-api.ts": ["sales", "service"],
    "lib/project-collaboration-api.ts": ["sales", "service", "engineering"],
    "lib/customer-project-followup-api.ts": ["sales"],
    "lib/customer-project-finance-api.ts": ["finance"],
    "lib/ar-workspace-api.ts": ["finance"],
    "lib/ar-invoice-ledger-api.ts": ["finance"],
    "lib/ar-customer-profiles-api.ts": ["finance"],
    "lib/ar-document-issue.ts": ["finance"],
    "lib/payment-terms-api.ts": ["finance"],
    "lib/handoff-business-api.ts": ["service", "engineering", "planning", "warehouse", "finance"],
    "lib/handoff-payment-actions.ts": ["service", "finance"],
    "lib/handoff-business-settings.ts": ["management"],
    "lib/handoff-production-review.ts": ["planning", "production"],
    "lib/handoff-framework-api.ts": ["sales", "service"],
    "lib/framework-finance-task.ts": ["finance", "service"],
    "lib/framework-offboarding.ts": ["management"],
    "lib/unified-communication-api.ts": ["sales", "service"],
    "lib/fixed-data-tools-api.ts": ["management"],
    "lib/fixed-tool-fees.ts": ["sales"]
  },
  "overrides": [
    {"actions": ["process-change-contract", "process-change", "process-change-preview", "process-change-confirm", "process-change-cancel"], "groups": ["sales", "service", "engineering", "planning", "warehouse", "quality", "finance"], "object": "流程变更人工预览、确认与执行回读", "boundary": "application-only", "note": "固定页面与受控客户端使用；不向模型注册任意确认工具。本人确认绑定完整预览、来源、规则和有效期；业务与回执同事务。"},
    {"actions": ["data", "read-version", "business-team-data"], "groups": ["sales", "service", "engineering", "planning", "purchasing", "warehouse", "production", "quality", "finance", "management"], "object": "授权聚合数据、版本与业务组目录", "note": "共用查询需按任务投影数据集和必要字段，不把整份聚合响应交给模型。"},
    {"actions": ["member", "enroll", "backup"], "groups": ["management"], "object": "成员与维护", "boundary": "human-admin-flow"},
    {"actions": ["inspect", "preview", "commit-import", "job", "template"], "groups": ["management", "planning", "production"], "object": "原表/MES 文件导入与批次", "note": "沿用原解析、批次及提交流程；预览可能保存原件与批次。"},
    {"actions": ["attachment", "file", "comment", "task"], "groups": ["planning", "production", "service"], "object": "订单附件、备注与任务"},
    {"actions": ["edit-order", "correction", "review", "match"], "groups": ["planning", "production"], "object": "订单维护与核对"},
    {"actions": ["pack"], "groups": ["production", "warehouse"], "object": "包装入仓"},
    {"actions": ["export", "ledger-export", "ledger-file", "metric-export"], "groups": ["planning", "production", "service"], "object": "订单原表与报表"},
    {"actions": ["ledger-preview", "ledger-commit"], "groups": ["management", "planning"], "object": "原版工作簿导入"},
    {"actions": ["ledger-assign", "ledger-lifecycle"], "groups": ["planning"], "object": "订单指派与归档"},
    {"actions": ["outsource-create"], "groups": ["purchasing", "production"], "object": "工序外发登记"},
    {"actions": ["receipt-photo", "receipt-confirm"], "groups": ["warehouse"], "object": "送货凭证与收货确认"},
    {"actions": ["customer-save", "customer-import", "customer-template", "customer-master-capabilities"], "groups": ["sales"], "object": "客户主档"},
    {"actions": ["kingdee-export", "kingdee-template"], "groups": ["planning", "management"], "object": "金蝶订单导出与模板"},
    {"actions": ["customer-project-drawing", "customer-project-drawing-withdraw", "customer-project-confirmation", "customer-project-sample-release", "customer-project-sample-update", "customer-project-sample-promise", "customer-project-sample-feedback"], "groups": ["engineering", "service"], "object": "项目图纸、签样与样办"},
    {"actions": ["customer-project-sample-dispatch", "customer-project-dispatch-receive"], "groups": ["warehouse", "service"], "object": "样办寄送与签收"},
    {"actions": ["customer-project-team-save", "customer-project-assignment-roster-save"], "groups": ["management"], "object": "项目团队与责任名单", "boundary": "human-admin-flow"},
    {"actions": ["customer-project-data", "customer-project-file", "customer-project-history", "customer-project-attachment"], "groups": ["sales", "service", "engineering", "warehouse"], "object": "项目、图纸与样办共用查询及原件"},
    {"actions": ["service-receipt", "service-receipt-reverse"], "groups": ["finance", "service"], "object": "客服业务收款及冲销"},
    {"actions": ["finished-supplier-qc"], "groups": ["quality", "purchasing"], "object": "成品外协质检"},
    {"actions": ["finished-supplier-receive", "finished-supplier-return", "finished-supplier-stock", "finished-supplier-shipment"], "groups": ["warehouse", "purchasing"], "object": "成品外协发运、收货、退货与入仓"},
    {"actions": ["finished-supplier-file", "finished-supplier-attachment"], "groups": ["warehouse", "purchasing", "quality"], "object": "成品外协凭证"},
    {"actions": ["finished-supplier-data"], "groups": ["purchasing", "warehouse", "quality"], "object": "成品外协授权视图"},
    {"actions": ["ar-access-grant-save", "ar-source-binding-save", "project-finance-grant-save", "payment-terms-authorizers-save", "customer-quote-access-update", "handoff-business-review-policy"], "groups": ["management"], "object": "业务授权与规则配置", "boundary": "human-admin-flow"},
    {"actions": ["framework-settings", "framework-config-save", "framework-account-save", "framework-knowledge", "framework-knowledge-document"], "groups": ["management"], "object": "业务规则、渠道配置与知识", "boundary": "human-admin-flow"},
    {"actions": ["framework-notices", "framework-notice-receive"], "groups": ["sales", "service", "engineering", "planning", "purchasing", "warehouse", "production", "quality", "finance", "management"], "object": "本人授权通知与签收"},
    {"actions": ["customer-quote-template-export"], "groups": ["sales"], "object": "客户报价模板成品", "boundary": "artifact-generation", "note": "GET 可能生成并归档文件，不能按纯读取接入。"}
  ],
  "processGroups": {
    "rfq": "sales",
    "sample": "engineering",
    "engineering-change": "engineering",
    "material-kit": "planning",
    "warehouse": "warehouse",
    "packaging": "warehouse",
    "iqc": "quality",
    "first-article": "quality",
    "process-quality": "quality",
    "outsourcing-quality": "quality",
    "oqc": "quality",
    "shipment-release": "quality",
    "supplier-reconciliation": "finance",
    "complaint": "service"
  },
  "typedFamilies": [
    {
      "id": "handoff-business",
      "label": "跨部门业务资料与单据",
      "handler": "lib/handoff-business-api.ts",
      "schemaSource": "lib/handoff-business.ts",
      "enumSource": "lib/handoff-business-catalog.ts",
      "enumNames": ["businessSourceTypes", "businessDocumentTypes"],
      "typeGroups": {
        "po": ["service"],
        "engineering_drawing": ["engineering"],
        "engineering_quote": ["engineering"],
        "production_order": ["planning", "service"],
        "production_shipment": ["warehouse"],
        "finance_file": ["finance"],
        "finance_request": ["finance", "service"],
        "pi": ["service", "finance"],
        "invoice": ["service", "finance"],
        "packing": ["warehouse", "service"],
        "paymentrequest": ["finance", "service"],
        "waybill": ["warehouse"]
      },
      "note": "按 kind/type 生成具体动作契约；共用视图按授权对象裁剪。来源版本、单据生成与财务状态继续由原接口校验，不以目录位置授予单据权限。"
    },
    {
      "id": "service-workspace",
      "label": "客服、发运签收与订单应收",
      "handler": "lib/service-workspace-api.ts",
      "schemaSource": "lib/service-workspace.ts",
      "enumSource": "lib/service-workspace.ts",
      "enumNames": ["serviceTypes"],
      "typeGroups": {
        "customer_profile": ["service"],
        "followup": ["service"],
        "project": ["service"],
        "sample": ["service"],
        "shipment": ["warehouse", "service"],
        "receivable": ["finance", "service"]
      },
      "note": "shipment-followups 和 service-receivables 复用此工作台，分别按 shipment、receivable 裁剪；不是两个新的业务数据库。"
    }
  ],
  "infrastructure": [
    {"method": "GET", "path": "/api/auth/session", "object": "会话摘要", "boundary": "application-only"},
    {"method": "POST", "path": "/api/auth/login", "object": "登录", "boundary": "application-only"},
    {"method": "POST", "path": "/api/auth/logout", "object": "注销", "boundary": "application-only"},
    {"method": "POST", "path": "/api/auth/password", "object": "本人改密", "boundary": "application-only"},
    {"method": "GET", "path": "/api/auth/maintenance", "object": "运行状态", "boundary": "human-admin-flow"},
    {"method": "GET", "path": "/api/auth/accounts", "object": "账号目录", "boundary": "human-admin-flow"},
    {"method": "POST", "path": "/api/auth/accounts", "object": "创建账号", "boundary": "human-admin-flow"},
    {"method": "GET", "path": "/api/auth/history", "object": "登录历史", "boundary": "human-admin-flow"},
    {"method": "POST", "path": "/api/auth/reset", "object": "重置密码", "boundary": "application-only"},
    {"method": "GET", "path": "/api/auth/backup", "object": "备份摘要", "boundary": "human-admin-flow"},
    {"method": "POST", "path": "/api/auth/backup", "object": "备份维护", "boundary": "human-admin-flow"},
    {"method": "GET", "path": "/api/agent-schedules/status", "object": "调度桥状态", "boundary": "application-only"},
    {"method": "POST", "path": "/api/agent-schedules/grant", "object": "本人定时授权", "boundary": "application-only"},
    {"method": "POST", "path": "/api/agent-schedules/revoke", "object": "撤销本人授权", "boundary": "application-only"},
    {"method": "POST", "path": "/api/agent-schedules/service/probe", "object": "服务身份探测", "boundary": "service-only"},
    {"method": "POST", "path": "/api/agent-schedules/service/lease", "object": "后台租约", "boundary": "service-only"},
    {"method": "POST", "path": "/api/agent-schedules/service/owners", "object": "有效授权人", "boundary": "service-only"},
    {"method": "POST", "path": "/api/agent-schedules/service/catalog", "object": "授权数据目录", "boundary": "service-only"},
    {"method": "POST", "path": "/api/agent-schedules/service/schedule", "object": "日历匹配", "boundary": "service-only"},
    {"method": "POST", "path": "/api/agent-schedules/service/verify", "object": "来源核验", "boundary": "service-only"},
    {"method": "POST", "path": "/api/agent-schedules/service/query", "object": "后台授权查询", "boundary": "service-only"},
    {"method": "GET", "path": "/health", "object": "存活状态", "boundary": "application-only"},
    {"method": "GET", "path": "/api/review-mode", "object": "验收副本标识", "boundary": "application-only"}
  ]
}
