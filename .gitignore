# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/.npm-cache/
/test-output/
*.tsbuildinfo
__pycache__/
*.py[cod]
/lan-data/
/lan-dist/

# Local credentials, source documents, and migration backups
/.openai/hosting.local.json
/originals-manifest.json
/import-expectations.json
*.bundle
*.sqlite*
*.db
*.key
*.p12
*.pfx
*.log

# Production backups stay private, including ciphertext and backup manifests.
/encrypted-backups/*
!/encrypted-backups/README.md
*.enc

# Original business documents and archives are never public test fixtures.
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv
*.pdf
*.zip
*.tar
*.gz
*.bak
*.dump
/backup-keys/

# Private import jobs, customer configuration, source files, and generated reports.
/private-data-tools/

# Retired one-off task script retained locally; do not publish it again.
/scripts/setup-jinbo-pilot.mjs

# Private local work notes and deployment target settings.
/.workbuddy/
/deploy-tool/local-config.json

# Retired production maintenance report, retained privately on this machine.
/协作修复说明-20260917.md
